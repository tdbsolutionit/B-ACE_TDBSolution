{
  "name": "bace-tdbsolution",
  "private": true,
  "version": "0.2.0",
  "description": "B-ACE SME — multi-tenant CRM (Next.js + NestJS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @bace/api",
    "dev:web": "npm run dev -w @bace/web",
    "build": "npm run build -w @bace/shared && npm run build -w @bace/api && npm run build -w @bace/web",
    "test": "npm run test -w @bace/api",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "node scripts/with-env.cjs -- npm run prisma:generate -w @bace/api",
    "db:migrate": "node scripts/with-env.cjs -- npm run prisma:deploy -w @bace/api",
    "db:seed": "node scripts/with-env.cjs -- npm run prisma:seed -w @bace/api",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/config": "^12.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "file-type": "^21.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10"
  },
  "overrides": {
    "multer": "^2.0.1",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.6",
    "deepmerge-ts": "^7.1.5",
    "zod": "^4.6.7",
    "uuid": "^14.0.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
